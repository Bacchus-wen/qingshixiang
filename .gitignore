# v4 shop: raw generations stay local (provenance JSON/manifests are committed)
assets/generated/tripo4/**/*.glb
assets/generated/tripo4/**/views/
assets/generated/shop/**/*.png
assets/generated/shop/**/*.glb
assets/generated/compare/**/*.glb
assets/generated/compare/**/*.png
assets/generated/compare/**/*.jpg
# LOD sets: the finest level (L0, ~1 GB) stays local -- the web version never loads it; L1-L3 (~294 MB) are committed so
# the Vercel build from this repo has them (2026-10-27: without them the deployed page stopped with "core system failed: eye")
assets/models/shop/lod/*/L0.glb
# raw generation downloads stay local (the shipped versions are the converted KTX2/JPG; manifests/JSON are committed)
assets/generated/vmc/**/*.png
assets/generated/hero2/**/*.png
assets/generated/child/**/*.png
assets/generated/codex/**/*.png
assets/generated/compare/**/*.out
# derived sources (Blender edits of raw generations): the GLB stays local, its README and the script are committed
assets/generated/derived/**/*.glb
# throwaway debug probes
tools/_*.mjs

# screen recordings for review (docs/judge/*/before.mp4, after.mp4): local only, too heavy for the repo
docs/judge/**/*.mp4
